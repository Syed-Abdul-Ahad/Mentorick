NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/mentorick
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=30d
CLIENT_URL=http://localhost:5173
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_ENV=sandbox
PAYPAL_PARTNER_ID=your_partner_merchant_id
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id
REVIEW_DAILY_LIMIT_ENABLED=true
REVIEW_DAILY_LIMIT_MAX=2
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback
GOOGLE_AUTH_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
SERVER_URL=http://localhost:5000
CLOUD_NAME=your_cloudinary_cloud_name
API_KEY=your_cloudinary_api_key
API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name